{
  "name": "vietwrite-conversations",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate:content && npm run vocabulary:validate && npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:pwa": "playwright test e2e/offline.spec.ts --config=playwright.pwa.config.ts",
    "test:watch": "vitest",
    "validate:content": "node --import tsx scripts/validate-content.ts",
    "content:report": "node --import tsx scripts/content-report.ts",
    "content:manifest": "node --import tsx scripts/generate-content-manifest.ts",
    "content:lint": "node --import tsx scripts/content-lint.ts",
    "content:new": "node --import tsx scripts/new-topic.ts",
    "content:new-topic": "node --import tsx scripts/new-topic.ts",
    "content:index": "node --import tsx scripts/generate-content-index.ts",
    "vocabulary:generate": "node --import tsx scripts/generate-vocabulary-data.ts",
    "vocabulary:validate": "node --import tsx scripts/validate-vocabulary.ts",
    "vocabulary:report": "node --import tsx scripts/vocabulary-report.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "clsx": "latest",
    "framer-motion": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "tailwind-merge": "latest",
    "vite": "latest",
    "vite-plugin-pwa": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "jsdom": "latest",
    "prettier": "latest",
    "tailwindcss": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vitest": "latest"
  }
}
